[Unit]
Description=Autarch - web dashboard (Next.js production server)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/autarch
# Build on every restart so pulled code + migrations are always applied.
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/npm run start -- -H 0.0.0.0 -p 3000
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# NOTE: the worker (npm run worker) and this web server share the same SQLite
# file in data/app.db. WAL mode handles concurrent access; keep both units
# pointing at the same repo directory.

[Install]
WantedBy=multi-user.target
